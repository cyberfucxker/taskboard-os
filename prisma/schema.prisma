model AgentConfig {
  id           String   @id @default(cuid())
  employeeId   String   @unique
  employee     Employee @relation(fields: [employeeId], references: [id])
  isActive     Boolean  @default(false)
  roleBrief    String   @default("") // what this person does day-to-day
  skills       Json     @default("[]") // array of {name, description, instructions}
  handoffRules Json     @default("{}") // when/how to delegate to AI
