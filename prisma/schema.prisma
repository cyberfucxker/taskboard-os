// ===========================================================================
// AUTOMATIONS — role-based automation builder (AUT-01)
// ===========================================================================

model Automation {
  id           String    @id @default(cuid())
  orgId        String
  org          Org       @relation(fields: [orgId], references: [id])
  createdById  String
  createdBy    Employee  @relation("AutomationCreator", fields: [createdById], references: [id])
  name         String
  description  String    @default("")
  trigger      Json // { type: "task_created"|"lead_stage_changed"|"project_created"|"schedule"|"manual"|"webhook", config: {} }
  conditions   Json      @default("[]") // [{ field, operator, value }]
  actions      Json // [{ type: "send_whatsapp"|"create_task"|"assign_task"|"send_email"|"call_ai"|"update_field"|"webhook", config: {} }]
  isActive     Boolean   @default(true)
  scope        String    @default("personal") // "personal" | "department" | "global"
  departmentId String? // set when scope = "department" — which department it's scoped to
  roleRestrict String[] // which roles can see/use this automation
  runCount     Int       @default(0)
  lastRunAt    DateTime?
