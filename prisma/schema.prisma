  error        String?
  createdAt    DateTime   @default(now())
}

model SystemIntegrationConfig {
  id              String    @id @default(cuid())
  provider        String    @unique
  name            String
  category        String    @default("AUTOMATION")
  isEnabled       Boolean   @default(false)
  status          String    @default("PENDING_CONFIG")
  credentialsJson Json      @default("{}")
  webhookUrl      String?
  lastSyncAt      DateTime?
  lastError       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([category])
}

model AttendanceOverride {
  id          String   @id @default(cuid())
  employeeId  String
  dateStr     String // yyyy-mm-dd, IST day
  status      String // PRESENT | HALF_DAY | ON_LEAVE | ABSENT
  hoursWorked Float    @default(0)
  otHours     Float    @default(0)
  setById     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([employeeId, dateStr])
  @@index([dateStr])
}

// Durable daily AI usage so budgets survive restarts and work across processes.
model AiUsageDaily {
  day              String   @id // YYYY-MM-DD (UTC)
  calls            Int      @default(0)
  failures         Int      @default(0)
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  totalTokens      Int      @default(0)
  costUsd          Decimal  @default(0) @db.Decimal(18, 6)
  budgetBlocked    Int      @default(0)
