// ---------------------------------------------------------------------------
// TASKBOARD OS — Core data model (engineering spec §4)
//
// Design rules honoured (from §4.2):
//   DM-01  Every table carries created_at/updated_at (+ created_by/updated_by
//          where it is human-authored; audited via the Activity log otherwise)
//   DM-02  Soft delete everywhere: `deletedAt` on every work/client entity
//   DM-04  Money as DECIMAL(18,2) minor-less major units + currency code (we
//          store rupees as Decimal with 2dp; never float)
//   DM-05  All timestamps UTC (Prisma DateTime is UTC); render tz on client
//   DM-06  Statuses are enums constrained by state machines (in service code)
//   DM-07  Activity is append-only — the source of truth for all KPI/AI work
//   DM-08  One Employee record; HR/projects/payroll/KPI all reference it
//   P5     Multi-tenant from day one: client-scoped rows carry client_id
//
// The Activity + Outcome + Outbox trio is the substrate for §15 (KPI engine)
// and §16 (AI agents). Design these first — retrofitting event capture is a
// rewrite, not a patch.
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===========================================================================
// ENUMS — statuses are enums backed by state machines (DM-06)
// ===========================================================================

enum Role {
  SUPER_ADMIN // COO / system owner
  DEPARTMENT_HEAD
  TEAM_LEAD
  SENIOR_EXECUTIVE
  EXECUTIVE
  INTERN
  ACCOUNT_MANAGER // client-facing POC
  HR
  FINANCE
  CLIENT_ADMIN // portal — tenant admin
  CLIENT_VIEWER // portal — read-only
  EXTERNAL_CONTRACTOR
}

enum EmployeeStatus {
  ACTIVE
  OVERLOADED
  ON_LEAVE
  PROBATION
  EXITED
}

enum TaskKind {
  STANDARD
  RECURRING
  APPROVAL_GATED
  DEPENDENT
  MILESTONE
  CHECKLIST
  TIME_BOXED
}

enum TaskCategory {
  CALL
  MEETING
  SCREENING
  BUG_FIX
  DEVELOPMENT
  DESIGN
  CRM
  ADMIN
  DOCUMENTATION
  OTHER
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  IN_REVIEW
  DONE
}

enum Priority {
  P0 // Critical
  P1 // High
  P2 // Medium
  P3 // Low
}

enum LeadStage {
  NEW
  CONTACTED
  QUALIFIED
  NEEDS_ANALYSIS
  PROPOSAL_SENT
  NEGOTIATION
  WON
  LOST
}

enum LeadSource {
  INBOUND // website / landing page
  META_LEAD_ADS
  GOOGLE_LEAD_FORM
  WHATSAPP
  INDIA_MART
  JUSTDIAL
  MARKETPLACE // Clutch, Upwork …
  REFERRAL
  CALL
  WALK_IN
  CHATBOT
  LINKEDIN
  IMPORTED // bulk CSV / manual migration into TaskBoard
  TELECRM // pulled from TeleCRM
  EMAIL
  OUTBOUND
  WEBINAR
  MANUAL
}

enum ClientHealth {
  HEALTHY
  WATCH
  AT_RISK
}

enum ContractStatus {
  DRAFT
  ACTIVE
  SUSPENDED
  EXPIRED
  TERMINATED
}

enum ProjectStatus {
  ONBOARDING
  ACTIVE
  PAUSED
  COMPLETED
  OFFBOARDED
}

enum MilestoneStatus {
  PLANNED
  IN_PROGRESS
  COMPLETE
  AT_RISK
}

enum Currency {
  INR
  USD
  EUR
  AED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  APPROVED_WITH_CHANGES // "Approve with changes"
  CHANGES_REQUESTED // "Request changes"
  REJECTED
}

// Activity event types — the typed event taxonomy. Grows as modules land.
enum ActivityType {
  AUTH_LOGIN
  AUTH_LOGOUT
  ROLE_SWITCHED

  TASK_CREATED
  TASK_UPDATED
  TASK_STATUS_CHANGED
  TASK_ASSIGNED
  TASK_BLOCKED
  TASK_UNBLOCKED
  TASK_COMPLETED
  TASK_REOPENED
  TASK_REWORK
  REVIEW_REQUESTED
  TASK_STARTED
  TASK_PAUSED
  SUBTASK_TOGGLED

  LEAD_CREATED
  LEAD_UPDATED
  LEAD_STAGE_CHANGED
  LEAD_DISPOSITION_LOGGED
  LEAD_CONVERTED

  CLIENT_CREATED
  CLIENT_UPDATED
  PROJECT_CREATED
  SERVICE_SELECTED

  OUTCOME_RECORDED
  AGENT_RUN

  COURSE_STARTED
  COURSE_COMPLETED
}

// ===========================================================================
// ORGANISATION SPINE
// ===========================================================================

model Org {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  timezone  String   @default("Asia/Kolkata")
  currency  Currency @default(INR)
  settings  Json? // branding, feature flags, fiscal config
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  departments Department[]
  clients     Client[]
  automations Automation[]
}

model Department {
  id         String    @id @default(cuid())
  orgId      String
  org        Org       @relation(fields: [orgId], references: [id])
  name       String
  slug       String // stable key for RBAC add-ons (DEPT_ADDONS) e.g. "sales", "finance"
  color      String    @default("#3E8B93")
  headId     String?
  head       Employee? @relation("DeptHead", fields: [headId], references: [id])
  costCentre String? // cost centre code
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  teams                  Team[]
  employees              Employee[]
  tasks                  Task[]
  services               Service[]
  departmentIntegrations DepartmentIntegration[]

  @@unique([orgId, name])
  @@unique([orgId, slug])
}

model Team {
  id           String     @id @default(cuid())
  name         String
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
  leadId       String?
  leadTeam     Employee?  @relation("TeamLead", fields: [leadId], references: [id])
  capacityHrs  Int? // weekly available capacity for the team
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?

  employees Employee[]
}

// ===========================================================================
// PEOPLE — single employee record (DM-08, CORE-02)
// ===========================================================================

model Employee {
  id                    String         @id @default(cuid())
  email                 String         @unique
  passwordHash          String? // null for SSO-only / portal users
  name                  String
  role                  Role           @default(EXECUTIVE)
  avatarInitials        String?
  title                 String? // e.g. "Head of SEO"
  // Reporting / org
  departmentId          String?
  department            Department?    @relation(fields: [departmentId], references: [id])
  teamId                String?
  team                  Team?          @relation(fields: [teamId], references: [id])
  managerId             String?
  manager               Employee?      @relation("ReportsTo", fields: [managerId], references: [id])
  reports               Employee[]     @relation("ReportsTo")
  // Rates (Finance + leadership only — §CORE-02.3)
  costRatePaise         Decimal?       @db.Decimal(18, 2) // daily cost rate, rupees
  billableRatePaise     Decimal?       @db.Decimal(18, 2) // daily billable rate, rupees
  currency              Currency       @default(INR)
  // Availability / capacity (CORE-02.4)
  weeklyCapacityHrs     Float?         @default(40)
  // Skills (drive routing at scale — CORE-02.2)
  skills                Json? // [{skill, level}]
  // HR profile (HRMS — maintained in-app by HR; additive, imported from HR's sheet)
  dob                   DateTime? // date of birth
  personalPhone         String? // personal / contact number (login email lives in `email`)
  personalEmail         String? // personal email
  workEmail             String? // work / company email (distinct from login `email` where they differ)
  emergencyContactName  String?
  emergencyContactPhone String?
  annualCtc             Decimal?       @db.Decimal(18, 2) // annual cost-to-company, rupees
  exitReason            String? // "Resigned" / "Terminated" / "Completed Internship"
  devices               Json? // [{deviceType, assetId, deviceId, serialNo, mobile, mobileModel, companySim, returned}]
  performanceReviews    Json? // [{reviewDate, position, response, improvements, goals, nextReviewDate}]
  toolAccess            Json? // [{platform, accessType, companyEmail, otherAccess, mailIdUsed}]
  // Lifecycle
  status                EmployeeStatus @default(ACTIVE)
  location              String?
  employmentType        String? // Full-time / Contractor / Intern
  joinedAt              DateTime?
  exitedAt              DateTime?
  lastLoginAt           DateTime?
  // RBAC overrides (CORE-01) — explicit per-employee allow/deny capability
  // chips layered by a SUPER_ADMIN on top of base(role) ∪ DEPT_ADDONS.
  // Shape: { allow?: Capability[], deny?: Capability[] } — never hardcoded.
  accessOverrides       Json?
  // Page-based access (CORE-01) — the COO's per-employee list of granted module
  // slugs ("" = NO pages for a brand-new employee; SUPER_ADMIN bypasses and sees
  // all). This is the source of truth for which pages appear in the sidebar and
  // which pages a guard lets the employee open.
  pageAccess            String[]       @default([])
  panelLock             Json? // { enabledPages: string[], pin?: string } — per-page lock veil
  // Shift state (persisted pause state across reloads/devices)
  shiftPaused           Boolean        @default(false)
  shiftPauseReason      String?
  shiftPausedAt         DateTime?
  // Tenant: 0 = internal; otherwise a client seat
  portalClientId        String?
  portalClient          Client?        @relation("PortalUsers", fields: [portalClientId], references: [id])
  deletedAt             DateTime?

  departmentHeadOf   Department[]       @relation("DeptHead")
  teamLeadOf         Team[]             @relation("TeamLead")
  assignedTasks      Task[]             @relation("Assignee")
  createdTasks       Task[]             @relation("Creator")
  ownedProjects      Project[]          @relation("ProjectOwner")
  leadsOwned         Lead[]             @relation("LeadOwner")
  approvalsRequested Approval[]         @relation("ApprovalRequester")
  approvalsOwned     Approval[]         @relation("ApprovalOwner")
  outcomesOwned      Outcome[]          @relation("OutcomeOwner")
  activities         Activity[]         @relation("Actor")
  notifications      Notification[]
  taskComments       TaskComment[]      @relation("CommentAuthor")
  taskReports        TaskReport[]       @relation("ReportAuthor")
  dailyUpdates       DailyUpdate[]
  pushSubscriptions  PushSubscription[]
  assignedViaJoin    TaskAssignee[]
  timeLogs           TimeLog[]
  manualTimeLogs     ManualTimeLog[]
  checkinState       CheckinState?
  workSessions       TaskWorkSession[]
  clientOwnerships   ClientOwner[]      @relation("ClientOwnerEmployees")
  proposalsApproved  SalesProposal[]    @relation("ProposalApprover")
  courseEnrollments  CourseEnrollment[]
  agentDevices       Device[]
  agentCommands      DeviceCommand[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  agentConfig            AgentConfig?
  automations            Automation[]            @relation("AutomationCreator")
  integrationConnections IntegrationConnection[]
  externalActivity       ExternalActivity[]

  // CRM (ported from the legacy CRM): telephony extension + calls this person took
  telephonyExtension String?
  crmCalls           CrmCallLog[] @relation("CrmCallAgent")

  @@index([managerId])
  focusBlocks      FocusBlock[]
}

// ===========================================================================
// CLIENTS — multi-tenant root (P5). Contact, Contract, Project all hang off.
// ===========================================================================

model Client {
  id           String       @id @default(cuid())
  orgId        String
  org          Org          @relation(fields: [orgId], references: [id])
  name         String
  region       String? // India / USA / Europe / UAE …
  industry     String?
  description  String? // engagement scope, e.g. "app, web, crm"
  health       ClientHealth @default(HEALTHY)
  healthScore  Int?         @default(70)
  pocId        String?      @unique // primary point of contact
  poc          Contact?     @relation("PrimaryPOC", fields: [pocId], references: [id])
  tier         String? // Tier 1 · Growth …
  // Portal white-labelling (CORE-07.1)
  portalConfig Json? // {logoColour, brandColour, customDomain, transparency}
  status       String?      @default("Active")
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  deletedAt    DateTime?

  contacts     Contact[]
  owners       ClientOwner[] @relation("ClientOwners")
  contracts    Contract[]
  projects     Project[]
  leads        Lead[]
  portalUsers  Employee[]    @relation("PortalUsers")
  integrations Integration[]
  activities   Activity[]
  tasks        Task[]
  invoices     Invoice[]
  approvals    Approval[]
  outcomes     Outcome[]
  assets       Asset[]

  @@unique([orgId, name])
}

// Client owners — a client can have MULTIPLE owner/AM employees (COO req).
model ClientOwner {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation("ClientOwners", fields: [clientId], references: [id], onDelete: Cascade)
  ownerId   String
  owner     Employee @relation("ClientOwnerEmployees", fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([clientId, ownerId])
  @@index([clientId])
}

model Contact {
  id              String    @id @default(cuid())
  clientId        String
  client          Client    @relation(fields: [clientId], references: [id])
  name            String
  role            String? // in client org
  email           String?
  phone           String?
  isPrimary       Boolean   @default(false)
  // consent flags (gov / sales) — honoured across channels
  consentEmail    Boolean   @default(false)
  consentWhatsApp Boolean   @default(false)
  consentCall     Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  primaryForClient Client? @relation("PrimaryPOC")

  @@index([clientId, email])
}

// ===========================================================================
// SERVICE CATALOGUE (CORE-03) — the most leveraged object in the system
// ===========================================================================

model Service {
  id                String      @id @default(cuid())
  name              String
  category          String? // bundle bucket for auto-recommendation, e.g. "marketing", "development", "design", "content", "performance"
  departmentId      String?
  department        Department? @relation(fields: [departmentId], references: [id])
  tier              String? // Tier 1 · Growth / Tier 2 · Scale / Tier 3 · Enterprise
  scope             String? // scope description
  deliverables      Json?       @default("[]") // [{name, qty, unit}]
  sla               String? // e.g. "4h response / 24h deliverable"
  pricePaise        Decimal?    @db.Decimal(18, 2)
  standardCostPaise Decimal?    @db.Decimal(18, 2)
  currency          Currency    @default(INR)
  billingCycle      String? // monthly / project / AMC
  // Task template — embeds SOP checklist inline (CORE-05.2)
  taskTemplate      Json?       @default("[]") // [{title, kind, priority, subtasks:[...]}]
  version           Int         @default(1)
  isTemplate        Boolean     @default(true)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  deletedAt         DateTime?

  contracts Contract[] @relation("ContractService")
  projects  Project[]
}

// ===========================================================================
// CONTRACT / PROJECT / MILESTONE
// ===========================================================================

model Contract {
  id               String         @id @default(cuid())
  clientId         String
  client           Client         @relation(fields: [clientId], references: [id])
  serviceId        String?
  service          Service?       @relation("ContractService", fields: [serviceId], references: [id])
  name             String
  valuePaise       Decimal?       @db.Decimal(18, 2)
  currency         Currency       @default(INR)
  status           ContractStatus @default(DRAFT)
  billingCycle     String?
  startDate        DateTime?
  endDate          DateTime?
  renewalType      String?
  noticePeriodDays Int?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  deletedAt        DateTime?

  projects Project[]
  invoices Invoice[]

  @@index([clientId])
}

model Project {
  id            String        @id @default(cuid())
  clientId      String
  client        Client        @relation(fields: [clientId], references: [id])
  contractId    String?
  contract      Contract?     @relation(fields: [contractId], references: [id])
  serviceId     String?
  service       Service?      @relation(fields: [serviceId], references: [id])
  name          String
  category      String? // bundle bucket, e.g. "digital-marketing", "web-development" — drives auto-recommendation
  status        ProjectStatus @default(ONBOARDING)
  description   String?
  ownerId       String? // delivery owner / AM
  owner         Employee?     @relation("ProjectOwner", fields: [ownerId], references: [id])
  startDate     DateTime?
  endDate       DateTime?
  budgetedHours Float?
  progressPct   Float?        @default(0)
  // Baseline snapshot (CORE-04.6) — immutable progress reference
  baseline      Json?
  scope         Json? // contracted vs delivered vs remaining
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?

  milestones Milestone[]
  tasks      Task[]

  @@index([clientId])
}

model Milestone {
  id                 String          @id @default(cuid())
  projectId          String
  project            Project         @relation(fields: [projectId], references: [id])
  name               String
  dueDate            DateTime?
  status             MilestoneStatus @default(PLANNED)
  acceptanceCriteria String?
  paymentTrigger     Boolean         @default(false)
  order              Int             @default(0)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  deletedAt          DateTime?

  tasks Task[]
}

// ===========================================================================
// TASKS ENGINE (CORE-05)
// ===========================================================================

model Task {
  id                String       @id @default(cuid())
  code              String       @unique // 3-char short code, e.g. "K9M"
  legacyCode        String?      @unique // old "TSK-101" code, kept as a lookup alias
  title             String
  description       String?
  kind              TaskKind     @default(STANDARD)
  category          TaskCategory @default(OTHER)
  status            TaskStatus   @default(TODO)
  priority          Priority     @default(P2)
  // Assignment (capacity-aware — CORE-05.6)
  assigneeId        String?
  assignee          Employee?    @relation("Assignee", fields: [assigneeId], references: [id])
  creatorId         String?
  descriptionBy     String? // id of the employee who last set the task description
  creator           Employee?    @relation("Creator", fields: [creatorId], references: [id])
  departmentId      String?
  department        Department?  @relation(fields: [departmentId], references: [id])
  clientId          String?
  client            Client?      @relation(fields: [clientId], references: [id])
  projectId         String?
  project           Project?     @relation(fields: [projectId], references: [id])
  milestoneId       String?
  milestone         Milestone?   @relation(fields: [milestoneId], references: [id])
  // Lever / outcome framing — "What done looks like" (from design)
  gainLever         String? // L1-Activation / L2-Retention / L3-Enterprise
  outcome           String? // definition of done / outcome callout
  // Timing & effort (CORE-05.5)
  dueDate           DateTime?
  dueLabel          String? // display label "Today / Tomorrow / Fri" from design
  estimateHrs       Float?
  actualHrs         Float?
  startedAt         DateTime?
  completedAt       DateTime?
  // Reschedule request — the worker's escape hatch. Workers CANNOT silently edit
  // commitment fields (due date / priority / assignee); instead they file a
  // request here and the controller (assigner) approves/denies it. Audit trail.
  // Shape: { proposedDueDate?, reason?, status: PENDING|APPROVED|DENIED,
  //          requestedById, requestedAt, decidedById?, decidedAt? }
  rescheduleRequest Json?
  // Blockers (CORE-05.3)
  blocked           Boolean      @default(false)
  blockerReason     String?
  blockerSev        String? // Critical / High / Medium
  // Dependencies
  dependsOnId       String?
  dependsOn         Task?        @relation("Dependency", fields: [dependsOnId], references: [id])
  dependents        Task[]       @relation("Dependency")
  // Rework (CORE-05.11) — reopen reason + originating stage
  reworkReason      String?
  reworkFromStage   String?
  // SLA (CORE-05.12)
  slaHours          Float?
  slaBreached       Boolean      @default(false)
  slaBreachedAt     DateTime?
  // Sort
  sortOrder         Int          @default(0)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  deletedAt         DateTime?
  archivedAt        DateTime?

  subtasks     Subtask[]
  comments     TaskComment[]
  reports      TaskReport[]
  assignees    TaskAssignee[]
  timeLogs     TimeLog[]
  workSessions TaskWorkSession[]
  // Many-to-many dependencies: this task's `dependencies` must be done before
  // it can proceed (auto-blocker). The legacy single `dependsOnId` is kept for
  // backward compat; new links are written through this join table.
  dependencies TaskDependency[]  @relation("TaskDependsOn")
  dependentOn  TaskDependency[]  @relation("TaskDependencyDependent")

  @@index([assigneeId])
  @@index([status])
  @@index([priority])
  @@index([clientId])
  @@index([projectId])
}

// Time tracking (CORE-05.5) — one row per employee per task per day. Drives the
// capacity/utilization layer: actual hours worked vs an employee's
// weeklyCapacityHrs, plus per-task estimates (Task.estimateHrs) vs logged time.
model TimeLog {
  id         String   @id @default(cuid())
  taskId     String
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  hours      Float
  date       DateTime // local day (start-of-day)
  note       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([taskId, employeeId, date])
  @@index([employeeId, date])
  @@index([taskId])
}

// Off-task manual hours — work done outside any tracked task (meetings,
// admin, general). TimeLog requires a taskId (on-task manual); this model
// covers the "I spent 2h on non-task work" case so the 8h meter can still
// count it (within the shift/productive window).
model ManualTimeLog {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  hours      Float
  date       DateTime // local day (start-of-day) — matches TimeLog.date convention
  note       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([employeeId, date])
}

// Interval-based task-completion check-in state (1:1 per employee).
// While a task is running, the app nudges "Still working on TSK-101? [Done]/[Not done]".
// Done → asks for outcome. Not done → increments streakNo; at 3 consecutive "not done"
// the next nudge asks for a reason. Nudges are suppressed while the running task's
// category is interrupt-sensitive (CALL / MEETING / SCREENING / CRM) — the app
// never pings someone mid-screening, client meeting, or call.
model CheckinState {
  employeeId    String    @id
  employee      Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  runningTaskId String? // task currently being tracked (the one nudges reference)
  lastAskedAt   DateTime? // when the last nudge was sent/rendered
  streakNo      Int       @default(0) // consecutive "not done" answers
  askReason     Boolean   @default(false) // true once streakNo >= 3 → next nudge asks why
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// One work session per (task ∘ assignee). A session is OPEN while the assignee
// is actively working (startedAt set, endedAt null) and CLOSED the moment they
// pause/complete. elapsedSec is frozen at close. Summing closed sessions gives
// "how much time each assignee has put in" — the only time that counts toward a
// task (the task itself returns to TODO on pause, so the running clock stops).
model TaskWorkSession {
  id         String    @id @default(cuid())
  taskId     String
  task       Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  assigneeId String
  assignee   Employee  @relation(fields: [assigneeId], references: [id], onDelete: Cascade)
  startedAt  DateTime  @default(now())
  endedAt    DateTime?
  elapsedSec Int? // frozen = endedAt − startedAt; null while open
  note       String?
  createdAt  DateTime  @default(now())

  @@index([taskId])
  @@index([assigneeId])
}

model FocusBlock {
  id     String @id @default(cuid())
  /// Employee who owns the block. One OPEN block per employee (partial unique index).
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  /// Ordered 1-3 task ids; position in the array IS the rank shown in the UI.
  taskIds String[]
  /// The single task currently accruing time (the one open TaskWorkSession).
  activeTaskId String
  startedAt    DateTime  @default(now())
  endedAt      DateTime?

  @@index([employeeId])
  @@index([endedAt])
}

// Many-to-many task dependencies — invisible-blocker detection. Task A depends
// on B (and C…); while any dependency is not DONE, A is auto-blocked.
model TaskDependency {
  id          String   @id @default(cuid())
  taskId      String
  task        Task     @relation("TaskDependsOn", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOnId String
  dependsOn   Task     @relation("TaskDependencyDependent", fields: [dependsOnId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([taskId, dependsOnId])
  @@index([dependsOnId])
}

// Many-to-many: a task can have multiple assignees. The single `assigneeId`
// remains as the "primary" assignee for backward compat (cards, leaderboard
// default). This join table tracks ALL assignees.
model TaskAssignee {
  id         String   @id @default(cuid())
  taskId     String
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([taskId, employeeId])
  @@index([employeeId])
}

model Subtask {
  id          String   @id @default(cuid())
  taskId      String
  task        Task     @relation(fields: [taskId], references: [id])
  title       String
  description String?
  status      String   @default("TODO")
  done        Boolean  @default(false)
  assigneeId  String?
  estimateHrs Decimal? @db.Decimal(6, 2)
  actualHrs   Decimal? @db.Decimal(6, 2)
  reviewNote  String?  @db.Text
  proofUrl    String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([taskId])
  @@index([assigneeId])
}

// Daily standup (mirrors legacy task tool daily-updates). One update per employee
// per day; feeds collaboration + the leaderboard's freshness signal.
model DailyUpdate {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  date       DateTime // local day (start-of-day, Asia/Kolkata)
  did        String? // what I did
  doing      String? // what I'm doing
  blockedOn  String? // blockers
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([employeeId, date])
  @@index([date])
}

// Task comment threads (migrated from a legacy tool + native). "Nothing about the
// work should change" — real collaboration context carries over on migration.
model TaskComment {
  id               String    @id @default(cuid())
  taskId           String
  task             Task      @relation(fields: [taskId], references: [id])
  authorId         String?
  author           Employee? @relation("CommentAuthor", fields: [authorId], references: [id])
  body             String
  mentionedUserIds Json?     @default("[]") // [{id, name}]
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([taskId])
}

// Task reports — lightweight in-DB file attachments replacing Slack drops.
// PDFs, images, CSVs up to 10 MB stored as BYTEA BLOBs; no external storage.
enum ReportKind {
  DAILY_REPORT
  WEEKLY_REPORT
  DESIGN_REVIEW
  BUG_REPORT
  GENERAL
}

model TaskReport {
  id        String     @id @default(cuid())
  taskId    String
  task      Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String?
  author    Employee?  @relation("ReportAuthor", fields: [authorId], references: [id])
  kind      ReportKind @default(GENERAL)
  title     String
  note      String?
  fileName  String
  mimeType  String
  sizeBytes Int
  data      Bytes
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([taskId])
  @@index([authorId])
}

// ===========================================================================
// LEADS / CRM (SALES module)
// ===========================================================================

model Lead {
  id              String     @id @default(cuid())
  name            String
  company         String
  email           String?
  phone           String?
  phoneNormalized String? // digits-only, indexed; NOT unique on purpose (see migration)
  emailNormalized String? // lowercased, indexed; NOT unique on purpose
  stage           LeadStage  @default(NEW)
  source          LeadSource @default(INBOUND)
  score           Int        @default(50) // 0-100 AI/enrichment score
  ownerId         String?
  owner           Employee?  @relation("LeadOwner", fields: [ownerId], references: [id])
  clientId        String? // when converted
  client          Client?    @relation(fields: [clientId], references: [id])
  nextStep        String?
  nextActionDate  DateTime?
  utm             Json? // full attribution chain (SALES-01.3)
  disposition     String? // structured outcome (SALES-02.3)
  lossReason      String? // taxonomy, mandatory on LOST (SALES-02.7)
  consent         Json? // opt-in flags by channel
  lastContactAt   DateTime?
  convertedAt     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  deletedAt       DateTime?

  workflow      LeadWorkflow?         @relation("LeadWorkflow")
  intelligences MeetingIntelligence[]
  proposals     SalesProposal[]
  followUps     FollowUpCadence[]

  @@index([stage])
  @@index([ownerId])
  @@index([email])
  @@index([phone])
}

// ===========================================================================
// AUTONOMOUS AI SALES ENGINE (GaaS — Growth as a Service)
//
// The founder's autonomous outbound/inbound sales loop. The AI owns the full
// lead lifecycle: greeting + Calendly booking on inbound, meeting intelligence
// (Dual Scoring) after discovery, AI-generated pricing proposals w/ regional
// gross-margin options, leadership approval gate, then auto-dispatch over
// WhatsApp / Email with an adaptive follow-up cadence that reacts to the
// prospect's objection signals (no time / low budget / ghosting).
// ===========================================================================

// Pipeline stage of an AI-accelerated lead flow. Distinct from Lead.stage
// (CRM pipeline) — this is the GaaS automation's finer-grained state machine.
enum LeadFlowStage {
  INBOUND_RECEIVED // lead query captured, AI greeting pending
  CONTACT_MADE // AI WhatsApp greeting sent with Calendly link
  CALENDLY_BOOKED // prospect booked a discovery slot
  MEETING_SCHEDULED // discovery confirmed (Calendly -> calendar)
  MEETING_HELD // discovery call completed, transcript captured
  PROPOSAL_DRAFTED // AI drafted regional pricing proposal
  PROPOSAL_PENDING_APPROVAL // awaiting leadership approval
  PROPOSAL_SENT // approved proposal dispatched
  NEGOTIATION
  WON
  LOST
}

// 1:1 with a Lead — the AI sales loop's operating state per lead.
model LeadWorkflow {
  id                 String        @id @default(cuid())
  leadId             String        @unique
  lead               Lead          @relation("LeadWorkflow", fields: [leadId], references: [id], onDelete: Cascade)
  whatsappThread     String? // WhatsApp Cloud API thread / conversation id
  calendlyBookedAt   DateTime? // when the prospect self-scheduled on Calendly
  meetingScheduledAt DateTime? // discovery confirmed on the calendar
  meetingEndedAt     DateTime? // discovery ended → triggers meeting-analysis
  stage              LeadFlowStage @default(INBOUND_RECEIVED)
  fallbackAssignedTo String? // Employee id if AI escalates / auto-response fails
  lastContactedAt    DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([stage])
  @@index([fallbackAssignedTo])
}

// Dual Scorecard produced by the AI from a discovery meeting transcript.
// Client side = deal quality signals; Rep side = pitch adherence / skill.
model MeetingIntelligence {
  id                     String   @id @default(cuid())
  leadId                 String   @unique
  lead                   Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  transcript             String? // raw meeting transcript (or reference)
  // Client / deal quality (0-100)
  clientScore            Int      @default(0)
  clientBudgetRating     Int      @default(0) // 0-100 budget adequacy
  clientSeriousnessScore Int      @default(0) // 0-100 intent to buy
  // Rep / pitch quality (0-100)
  repScore               Int      @default(0)
  repPitchAdherence      Int      @default(0) // 0-100 adherence to pitch playbook
  momSummary             String? // minutes-of-meeting AI summary
  clientQuestions        Json?    @default("[]") // [{question, sentiment, addressed}]
  teamPitched            Json?    @default("[]") // [{employeeId, name, role, talkRatio}]
  actionItems            Json?    @default("[]") // [{assignee, due, text}]
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([clientScore])
  @@index([repScore])
}

enum SalesProposalStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SENT
  REJECTED
}

enum SalesProposalSentVia {
  EMAIL
  WHATSAPP
}

// AI-generated regional pricing proposal. FTE cost → margin-aware price points.
model SalesProposal {
  id                  String                @id @default(cuid())
  leadId              String
  lead                Lead                  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  status              SalesProposalStatus   @default(DRAFT)
  fteAllocationJson   Json                  @default("[]") // [{role, fte, monthlyCostPaise}]
  costPaise           Decimal               @db.Decimal(18, 2) // total monthly delivery cost
  suggestedPricePaise Decimal               @db.Decimal(18, 2) // AI-recommended price
  grossMarginPct      Float? // gross margin % on suggested price
  targetRegion        String? // India / USA / UAE / Europe …
  draftedByAi         Boolean               @default(true)
  approvedById        String?
  approvedBy          Employee?             @relation("ProposalApprover", fields: [approvedById], references: [id])
  approvedAt          DateTime?
  sentVia             SalesProposalSentVia? // null while not yet SENT
  content             Json? // dispatch-ready email/whatsapp body w/ pricing table
  sentAt              DateTime?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  @@index([leadId])
  @@index([status])
  @@index([targetRegion])
}

enum FollowUpTriggerReason {
  NO_RESPONSE // prospect ghosted after proposal / greeting
  BUDGET_CONCERN // objection: too expensive
  NO_TIME // objection: busy, no time now
  FOMO // urgency / limited offer close
}

enum FollowUpStatus {
  PENDING
  SENT
  CANCELLED
}

// Adaptive re-engagement sequence. One row per follow-up step per lead; AI
// fills scheduledAt + messageTemplate based on the objection detected.
model FollowUpCadence {
  id              String                @id @default(cuid())
  leadId          String
  lead            Lead                  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  stepNumber      Int // 1, 2, 3 … sequence position
  triggerReason   FollowUpTriggerReason
  messageTemplate String // rendered message body (channel-neutral)
  scheduledAt     DateTime // when the AI plans to send it
  sentAt          DateTime? // null until actually dispatched
  status          FollowUpStatus        @default(PENDING)
  channel         String? // WHATSAPP | EMAIL — which channel it will go out on
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@unique([leadId, stepNumber])
  @@index([status, scheduledAt])
}

// ===========================================================================
// EVENT LOG — append-only, the source of truth for KPI + AI (§15/§16, DM-07)
// ===========================================================================

model Activity {
  id         String       @id @default(cuid())
  type       ActivityType
  actorId    String?
  actor      Employee?    @relation("Actor", fields: [actorId], references: [id])
  entityType String // 'task' | 'lead' | 'client' | 'project' | ...
  entityId   String
  clientId   String? // tenant scoping
  client     Client?      @relation(fields: [clientId], references: [id])
  payload    Json // versioned structured payload {"v":1, ...}
  occurredAt DateTime     @default(now())
  meta       Json? // {source, requestId, sessionId}

  outcomes Outcome[]
  outbox   Outbox?

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([clientId])
  @@index([type])
  @@index([occurredAt])
}

// Outcome — measured result attributable to work (KPI-01.2).
model Outcome {
  id          String    @id @default(cuid())
  activityId  String?
  activity    Activity? @relation(fields: [activityId], references: [id])
  metricKey   String // canonical metric definition ref (KPI-01.1/09.1)
  value       Float
  unit        String?
  ownerId     String? // employee credited (with attribution rule)
  owner       Employee? @relation("OutcomeOwner", fields: [ownerId], references: [id])
  clientId    String?
  client      Client?   @relation(fields: [clientId], references: [id])
  attribution String? // FULL / SPLIT / TEAM
  periodStart DateTime?
  periodEnd   DateTime?
  occurredAt  DateTime  @default(now())

  @@index([metricKey, occurredAt])
}

// Outbox — durable outbound event queue. The MCP / n8n / webhook bridge.
// emitEvent() writes Activity + Outbox atomically; a worker later publishes
// and marks `publishedAt`. This is the contract every external integration
// (incl. future AI/MCP listeners) consumes without touching operational code.
model Outbox {
  id          String    @id @default(cuid())
  activityId  String    @unique
  activity    Activity  @relation(fields: [activityId], references: [id])
  topic       String // e.g. "task.completed", "lead.converted"
  payload     Json
  publishedAt DateTime?
  attempts    Int       @default(0)
  lastError   String?
  createdAt   DateTime  @default(now())

  @@index([publishedAt])
  @@index([topic])
}

// ===========================================================================
// APPROVALS (CORE-06) — one shared engine for every department
// ===========================================================================

model Approval {
  id            String         @id @default(cuid())
  entityType    String // 'post' | 'creative' | 'design' | 'proposal' | 'leave' | ...
  entityId      String
  stage         String // Creator -> Internal QC -> POC -> Client -> Released
  status        ApprovalStatus @default(PENDING)
  requestedById String?
  requestedBy   Employee?      @relation("ApprovalRequester", fields: [requestedById], references: [id])
  ownerId       String? // current approver
  owner         Employee?      @relation("ApprovalOwner", fields: [ownerId], references: [id])
  reason        String? // structured reason taxonomy + free text (CORE-06.4)
  clientId      String?
  client        Client?        @relation(fields: [clientId], references: [id])
  version       Int            @default(1)
  dueAt         DateTime?
  decidedAt     DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([entityType, entityId])
}

// ===========================================================================
// FINANCE (FIN) — contracts + invoices
// ===========================================================================

model Invoice {
  id          String    @id @default(cuid())
  clientId    String
  client      Client    @relation(fields: [clientId], references: [id])
  contractId  String?
  contract    Contract? @relation(fields: [contractId], references: [id])
  number      String    @unique
  amountPaise Decimal?  @db.Decimal(18, 2)
  currency    Currency  @default(INR)
  status      String // Draft / Sent / Due / Paid
  dueDate     DateTime?
  issuedAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([clientId])
}

// ===========================================================================
// DIGITAL ASSET MANAGEMENT (CORE-10.3) — stub entity for DAM future-proofing
// ===========================================================================

model Asset {
  id        String    @id @default(cuid())
  name      String
  kind      String // image / video / document / brand-kit
  clientId  String?
  client    Client?   @relation(fields: [clientId], references: [id])
  url       String?
  tags      String[]  @default([])
  version   Int       @default(1)
  approval  String? // Review / Approved / Rejected
  rights    Json? // licence, expiry
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([clientId, kind])
}

// Resource link type — the icon/category badge shown on a vault item
enum ResourceLinkType {
  DRIVE_LINK
  GOOGLE_SHEET
  NOTION_DOC
  FIGMA
  API_PORTAL
  SOP_GUIDE
  CREDENTIAL_BOOKMARK
}

// Department Resources & Technical SOP Hub — a shared link/vault registry. Each
// item carries its source department (denormalized slug) so the hub can be
// filtered by department without a join, plus an optional tags array for the
// cross-vault search. Soft-deleted like every work entity (DM-02).
model DepartmentResource {
  id             String           @id @default(cuid())
  title          String
  department     String // display name e.g. "Tech & Engineering"
  departmentSlug String // stable key for filter chips e.g. "engineering"
  linkType       ResourceLinkType @default(DRIVE_LINK)
  url            String
  description    String?
  tags           String[]         @default([])
  addedById      String?
  addedByName    String? // denormalized for cheap "Added by" display
  pinned         Boolean          @default(false)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  deletedAt      DateTime?

  @@index([departmentSlug])
  @@index([pinned])
}

// ===========================================================================
// METRICS — canonical definitions + time series (CORE-09.1, warehouse-ready)
// ===========================================================================

model Metric {
  id         String   @id @default(cuid())
  key        String   @unique // canonical key, e.g. "leads.qualified"
  name       String
  definition String // single canonical definition across all dashboards
  unit       String?
  kind       String // activity | outcome
  ownerRole  String? // which role this KPI applies to (KPI-02)
  pctOf      Json? // config
  createdAt  DateTime @default(now())

  values MetricValue[]
}

model MetricValue {
  id         String   @id @default(cuid())
  metricKey  String
  metric     Metric   @relation(fields: [metricKey], references: [key])
  clientId   String?
  employeeId String?
  period     DateTime // period start
  value      Float
  meta       Json?
  createdAt  DateTime @default(now())

  @@index([metricKey, period])
  @@index([clientId, period])
}

// ===========================================================================
// INTEGRATIONS (ARCH-06, CORE-08) — connector registry. Every third-party
// API is isolated behind an adapter; this table tracks connector health.
// ===========================================================================

model Integration {
  id                  String    @id @default(cuid())
  provider            String // google-ads | meta-ads | gsc | ga4 | ubersuggest | ...
  clientId            String?
  client              Client?   @relation(fields: [clientId], references: [id])
  status              String    @default("configured") // configured | syncing | degraded | error
  lastSyncAt          DateTime?
  nextRetryAt         DateTime?
  consecutiveFailures Int       @default(0)
  lastError           String?
  configRef           String? // encrypted credential vault reference (never the secret)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([provider, clientId])
}

// ===========================================================================
// AI AGENTS (AGT) — every agent action logged w/ inputs, model, confidence (AGT-04.2)
// ===========================================================================

model AgentRun {
  id         String  @id @default(cuid())
  agent      String // qa | anomaly | lead-enrich | digest | ...
  action     String
  inputs     Json
  output     Json?
  confidence Float?
  model      String?
  status     String // running | succeeded | failed | needs_approval

  // ── Audit trail ──────────────────────────────────────────────────────────
  principalId      String? // employee who invoked the run (null = system/cron)
  source           String? // entry point, e.g. "api/ai/run", "agent/run-task"
  promptTokens     Int       @default(0)
  completionTokens Int       @default(0)
  latencyMs        Int       @default(0)
  attempts         Int       @default(0)
  error            String?
  errorKind        String? // AIError.kind
  requiresApproval Boolean   @default(false)
  finishedAt       DateTime?
  costUsd          Decimal?  @db.Decimal(18, 6)

  spentPaise Decimal? @db.Decimal(18, 2) // model cost attribution (AGT-04.6)
  approvedBy String? // human approval gate (AGT-04.3)
  createdAt  DateTime @default(now())

  @@index([agent, createdAt])
  @@index([principalId, createdAt])
  @@index([status, createdAt])
}

// ===========================================================================
// NOTIFICATIONS (CORE-10.1) — targeted, digestible
// ===========================================================================

model Notification {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  title      String
  detail     String
  severity   String? // Critical / High / Info
  kind       String? // blocker / sla / digest / alert
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([employeeId, read])
}

// Web Push subscription (PWA — free browser push service, no daemon needed).
// One row per browser/device an employee has enabled notifications on.
model PushSubscription {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  endpoint   String   @unique
  p256dh     String
  auth       String
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([employeeId])
}

// ===========================================================================
// LMS — learn-by-doing training modules (Learning tab). A Course is a
// versioned, JSON-authored set of blocks (tasks/fields/drills/checks/trap);
// progress is tracked per employee per block so leadership can see not just
// completion %, but the actual work a rep produced.
// ===========================================================================

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum EnrollmentStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

model Course {
  id          String       @id @default(cuid())
  slug        String       @unique
  title       String
  description String?
  department  String? // informational tag e.g. "sales" — not a hard visibility gate
  content     Json // { blocks: [{ id, title, goal, tasks?, fields?, drills?, checks, trap? }] }
  status      CourseStatus @default(PUBLISHED)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?

  enrollments CourseEnrollment[]
}

model CourseEnrollment {
  id              String           @id @default(cuid())
  courseId        String
  course          Course           @relation(fields: [courseId], references: [id])
  employeeId      String
  employee        Employee         @relation(fields: [employeeId], references: [id])
  status          EnrollmentStatus @default(NOT_STARTED)
  currentBlockIdx Int              @default(0)
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  blocks CourseBlockProgress[]

  @@unique([courseId, employeeId])
  @@index([employeeId])
  @@index([courseId])
}

model CourseBlockProgress {
  id           String           @id @default(cuid())
  enrollmentId String
  enrollment   CourseEnrollment @relation(fields: [enrollmentId], references: [id])
  blockId      String // matches a block's `id` inside Course.content, e.g. "b0"
  checks       Json? // { [taskIndex]: boolean }
  fields       Json? // { [fieldId]: string }
  drillAnswers Json? // { [drillIndex]: { answer, revealed } }
  completed    Boolean          @default(false)
  startedAt    DateTime?
  completedAt  DateTime?
  elapsedSec   Int              @default(0) // display-only, never enforced/limited
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([enrollmentId, blockId])
  @@index([enrollmentId])
}

model Device {
  id           String    @id @default(cuid())
  employeeId   String
  employee     Employee  @relation(fields: [employeeId], references: [id])
  hostname     String?
  os           String? // windows, macos, linux
  agentVersion String?
  lastSeenAt   DateTime?
  createdAt    DateTime  @default(now())
  deletedAt    DateTime?

  activities  DeviceActivity[]
  commands    DeviceCommand[]
  screenshots Screenshot[]

  @@index([employeeId])
}

model DeviceActivity {
  id           String   @id @default(cuid())
  deviceId     String
  device       Device   @relation(fields: [deviceId], references: [id])
  timestamp    DateTime @default(now())
  activeApp    String?
  activeWindow String?
  category     String? // WORK, PERSONAL, MEETING, BREAK, UNKNOWN
  keystrokes   Int      @default(0)
  mouseClicks  Int      @default(0)
  url          String?
  cpuUsage     Float?
  memUsage     Float?

  @@index([deviceId, timestamp])
  @@index([timestamp])
}

model DeviceCommand {
  id         String    @id @default(cuid())
  deviceId   String
  device     Device    @relation(fields: [deviceId], references: [id])
  type       String // SCREENSHOT, LOCK, LOGOUT, NOTIFICATION, PING
  payload    Json?
  status     String    @default("PENDING") // PENDING, EXECUTING, DONE, FAILED
  result     Json?
  issuedById String?
  issuedBy   Employee? @relation(fields: [issuedById], references: [id])
  issuedAt   DateTime  @default(now())
  executedAt DateTime?
  createdAt  DateTime  @default(now())

  screenshots Screenshot[]

  @@index([deviceId, status])
  @@index([issuedAt])
}

model Screenshot {
  id         String         @id @default(cuid())
  commandId  String?
  command    DeviceCommand? @relation(fields: [commandId], references: [id])
  deviceId   String
  device     Device         @relation(fields: [deviceId], references: [id])
  filename   String
  mimeType   String         @default("image/png")
  sizeBytes  Int?
  width      Int?
  height     Int?
  storageUrl String?
  createdAt  DateTime       @default(now())

  @@index([deviceId, createdAt])
}

// ==========================================
// SYSTEM CONFIG & MEETING SCHEDULING ENGINES
// ==========================================

model SystemConfig {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String   @db.Text
  category    String   @default("GENERAL") // GENERAL, INTEGRATION, AI, SYSTEM
  description String?
  isSecret    Boolean  @default(false)
  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
}

model MeetingSchedule {
  id              String   @id @default(cuid())
  title           String
  description     String?  @db.Text
  platform        String   @default("GOOGLE_MEET") // GOOGLE_MEET, ZOOM, MICROSOFT_TEAMS, CUSTOM
  meetingUrl      String
  passcode        String?
  scheduledAt     DateTime
  durationMinutes Int      @default(30)
  status          String   @default("SCHEDULED") // SCHEDULED, IN_PROGRESS, COMPLETED, CANCELLED
  hostId          String
  clientId        String?
  projectId       String?
  taskId          String?
  attendees       Json?    @default("[]") // Array of emails or employee IDs
  notes           String?
  recordingUrl    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([hostId])
  @@index([scheduledAt])
  @@index([clientId])
  @@index([projectId])
}

model EmployeeIntegration {
  id              String    @id @default(cuid())
  employeeId      String
  provider        String // GOOGLE, CALENDLY, WHATSAPP, ZOOM, GITHUB, ICAL
  personalMeetUrl String?
  calendlyUrl     String?
  icalUrl         String? // manual read-only calendar feed URL (Google/Outlook secret ICS link)
  accountEmail    String?
  whatsappPhone   String?
  accessToken     String?   @db.Text
  refreshToken    String?   @db.Text
  tokenExpiresAt  DateTime?
  settings        Json?     @default("{}")
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([employeeId, provider])
  @@index([employeeId])
}

model RecurringTaskTemplate {
  id              String    @id @default(cuid())
  title           String
  description     String?   @db.Text
  departmentId    String?
  departmentName  String?
  role            String? // SUPER_ADMIN, TEAM_LEAD, EXECUTIVE, etc.
  frequency       String    @default("DAILY") // DAILY, WEEKLY, MONTHLY
  scheduledDays   String[]  @default(["MON", "TUE", "WED", "THU", "FRI"])
  scheduledTime   String    @default("09:30")
  priority        String    @default("MEDIUM")
  assigneeId      String?
  subtasks        Json?     @default("[]") // Array of subtask titles/templates
  isActive        Boolean   @default(true)
  lastTriggeredAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([departmentId])
  @@index([frequency])
}

model WorkflowStream {
  id             String   @id @default(cuid())
  // Owned by exactly one employee — "strictly per-person, not shared with
  // your whole department" per explicit product direction. departmentSlug is
  // kept only as informational metadata (what dept they were in when this
  // was seeded), never used to scope visibility or editing.
  employeeId     String
  departmentSlug String?
  key            String
  title          String
  category       String
  icon           String   @default("Sparkles")
  colorHex       String   @default("#3E8B93")
  sortOrder      Int      @default(0)
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([employeeId, key])
  @@index([employeeId])
}

model PersonConfig {
  id            String   @id @default(cuid())
  employeeId    String
  moduleType    String
  configJson    Json
  version       Int      @default(1)
  effectiveFrom DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([employeeId, moduleType, version])
  @@index([employeeId])
}

model TodayCommitment {
  id          String    @id @default(cuid())
  employeeId  String
  taskId      String
  slot        Int
  dateStr     String
  pinnedAt    DateTime  @default(now())
  completedAt DateTime?

  @@unique([employeeId, dateStr, slot])
  @@index([employeeId, dateStr])
}

model Artifact {
  id                 String    @id @default(cuid())
  taskId             String
  createdById        String
  artifactType       String // FIGMA, GITHUB_PR, LOOM, DOC, SPREADSHEET, ASSET
  title              String
  url                String?   @db.Text
  previewUrl         String?   @db.Text
  tier               Int       @default(0)
  metadata           Json?
  verificationStatus String    @default("PENDING") // PENDING, APPROVED, REJECTED
  verifiedById       String?
  verifiedAt         DateTime?
  rejectionReason    String?   @db.Text
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([taskId])
  @@index([createdById])
}

model Blocker {
  id             String    @id @default(cuid())
  taskId         String
  createdById    String
  reason         String    @db.Text
  status         String    @default("ACTIVE")
  resolvedById   String?
  resolvedAt     DateTime?
  resolutionNote String?   @db.Text
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([taskId])
  @@index([createdById])
}

// ===========================================================================
