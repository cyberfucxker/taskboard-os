}

model IntegrationConnection {
  id              String             @id @default(cuid())
  employeeId      String
  employee        Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  provider        String
  externalId      String?
  displayName     String?
  scopes          String[]           @default([])
  accessTokenEnc  String?
  refreshTokenEnc String?
  tokenExpiresAt  DateTime?
  status          String             @default("active")
  statusDetail    String?
  lastSyncedAt    DateTime?
  lastErrorAt     DateTime?
  lastError       String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  activity        ExternalActivity[]

  @@unique([employeeId, provider])
  @@index([employeeId])
  @@index([provider])
}

model ExternalActivity {
  id              String                 @id @default(cuid())
  provider        String
  providerEventId String
  connectionId    String?
  connection      IntegrationConnection? @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  employeeId      String?
  employee        Employee?              @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  projectId       String?
  taskId          String?
  kind            String
  title           String?
  detail          String?
  url             String?
  additions       Int?
  deletions       Int?
  filesChanged    Int?
  occurredAt      DateTime
  raw             Json?
  createdAt       DateTime               @default(now())

  @@unique([provider, providerEventId])
  @@index([employeeId, occurredAt])
  @@index([projectId, occurredAt])
  @@index([kind, occurredAt])
