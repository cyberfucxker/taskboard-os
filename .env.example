# TaskBoard OS environment template.
# Copy to .env (never commit .env) and fill in values. Leave optional values empty to disable the feature.

# --- Core (required) ---------------------------------------------------------
# PostgreSQL connection string, e.g. postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public
DATABASE_URL=
# Public URL of this app (used for auth callbacks and links in emails)
NEXTAUTH_URL=http://localhost:3000
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET=
# Set to true when running behind a reverse proxy
AUTH_TRUST_HOST=
# Password given to the demo accounts created by `npm run db:seed` (required for seeding)
SEED_PASSWORD=
# Optional: base URL for links generated by the CRM server (falls back to NEXTAUTH_URL)
PUBLIC_BASE_URL=
CLIENT_ORIGIN=
# IANA timezone used for CRM reminders and date bucketing (default Asia/Kolkata)
ORG_TIME_ZONE=
TZ=UTC

# --- Auth options ------------------------------------------------------------
# Google sign-in (optional). Only existing employees may sign in unless ALLOWED_EMAIL_DOMAIN matches.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: auto-admit any Google account on this domain (e.g. example.com)
ALLOWED_EMAIL_DOMAIN=
# true enables the role-switcher for non-admin users. Demo/staging only. Never enable in production.
DEMO_ROLE_SWITCH=
NEXT_PUBLIC_DEMO_ROLE_SWITCH=
# UI rollout gate for the v3 theme: off | pilot | all
TASKBOARD_V3_ROLLOUT=off
# Comma-separated emails that see the v3 theme when rollout=pilot
TASKBOARD_V3_PILOT_EMAILS=

# --- Secrets for machine-to-machine access ----------------------------------
# Shared secret for scheduled jobs (sent as x-cron-secret header to /api/cron/*)
CRON_SECRET=
# Shared secret for desktop/device agents and agent endpoints (x-agent-secret header)
AGENT_SECRET=
# Bearer keys for the agent-context API and the MCP endpoint
TASKBOARD_AGENT_KEY=
TASKBOARD_MCP_KEY=
# 32-byte base64 key for the credential vault. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
INTEGRATION_ENCRYPTION_KEY=
# Optional dedicated secret for signing CRM email unsubscribe links (falls back to NEXTAUTH_SECRET)
CRM_UNSUBSCRIBE_SECRET=

# --- AI (optional; any OpenAI-compatible chat-completions gateway) ---------------
AI_GATEWAY_BASE_URL=http://localhost:4000/v1
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=gpt-4o-mini
AI_GATEWAY_FALLBACK_MODEL=
# Tuning (all optional)
AI_TIMEOUT_MS=
AI_MAX_RETRIES=
AI_RETRY_BASE_MS=
AI_CIRCUIT_FAILURES=
AI_CIRCUIT_OPEN_MS=
AI_MAX_CONCURRENT=
AI_RATE_LIMIT_PER_MIN=
AI_DAILY_TOKEN_BUDGET=
AI_DAILY_COST_BUDGET_USD=

# --- Email (optional) ---------------------------------------------------------
# Nodemailer-style transport URL, e.g. smtp://USER:PASS@smtp.example.com:587
SMTP_URL=
SALES_EMAIL_FROM=sales@example.com
# Employee email/id that receives leads when auto-assignment fails
SALES_FALLBACK_OWNER=
CALENDLY_URL_SALES=

# --- Web push (optional). Generate keys: npx web-push generate-vapid-keys ------
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=mailto:admin@example.com

# --- WhatsApp Business Cloud API (optional) ------------------------------------
WHATSAPP_API_TOKEN=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# --- Meta (Facebook/Instagram) lead ads (optional) -----------------------------
META_APP_ID=
META_APP_SECRET=
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
META_FORM_IDS=
META_VERIFY_TOKEN=
META_WEBHOOK_VERIFY_TOKEN=
# JSON array routing Meta forms/campaigns to pipelines, e.g.
# [{"keywords":["real estate"],"pipelineName":"real estate"}]
CRM_PIPELINE_OVERRIDES=

# --- TeleCRM lead sync (optional) ----------------------------------------------
TELECRM_SYNC_ENABLED=
TELECRM_BASE_URL=
TELECRM_ENTERPRISE_ID=
TELECRM_SYNC_TOKEN=

# --- Third-party OAuth integrations (optional; can also be set in the Settings UI) ---
GOOGLE_WORKSPACE_DOMAIN=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# --- Build ----------------------------------------------------------------------
# Optional alternate Next.js output directory
NEXT_DIST_DIR=
